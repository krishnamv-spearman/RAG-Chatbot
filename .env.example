# Copy to .env (project root) and fill in. Never commit .env.

# --- LLM (Groq) ---
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
# Groq account limits (openai/gpt-oss-120b). Calls are budgeted client-side.
LLM_REQUESTS_PER_MINUTE=30
LLM_TOKENS_PER_MINUTE=8000
LLM_REQUESTS_PER_DAY=1000
LLM_TOKENS_PER_DAY=200000
LLM_MAX_WAIT_SECONDS=10

# --- Retrieval (used from Phase 2) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_TOP_K=5
# Min. vector cosine similarity to treat a question as answerable (tuned in Phase 2)
RELEVANCE_THRESHOLD=0.57

# --- Vector store ---
# chroma         local files in data/chroma (default, development)
# chroma_remote  shared Chroma server or Chroma Cloud (needed for the daily GitHub Actions refresh)
# pinecone       optional, pip install -e ".[pinecone]"
VECTOR_STORE=chroma
# chroma_remote, self-hosted server:
# CHROMA_HOST=your-chroma-host
# CHROMA_PORT=443
# CHROMA_SSL=true
# CHROMA_AUTH_TOKEN=your-token
# chroma_remote, Chroma Cloud (used when CHROMA_API_KEY is set):
# CHROMA_API_KEY=your-chroma-cloud-key
# CHROMA_TENANT=your-tenant
# CHROMA_DATABASE=your-database
# How often the app checks for a new index version (seconds; 0 = never)
INDEX_REFRESH_SECONDS=300
# /api/health reports stale=true when the data is older than this
STALE_AFTER_DAYS=2
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_INDEX=mf-faq
# PINECONE_NAMESPACE_PREFIX=dev
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# --- Paths ---
DATA_DIR=data

# --- API ---
CORS_ORIGINS=http://localhost:5173
API_MESSAGES_PER_MINUTE=20
API_MAX_REQUEST_BYTES=16384
